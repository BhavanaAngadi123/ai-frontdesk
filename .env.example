# ── FrontDesk · environment template ─────────────────────────────
# Copy to .env and fill in. NEVER commit a real .env to git.

# App
APP_NAME=FrontDesk
APP_ENV=dev                      # dev | prod
DATABASE_URL=sqlite:///./frontdesk.db
# Postgres when you're ready (Render/Supabase/Neon all work):
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/frontdesk

# Owner dashboard auth — set a long random string in prod.
# Dev default below is intentionally weak; the app warns on boot.
OWNER_TOKEN=dev-owner-token-change-me

# ── LLM (pluggable) ─────────────────────────────────────────────
# Leave LLM_API_KEY empty to run in clearly-labeled DEMO mode
# (rule-based replies; every response carries demo_mode=true).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20

# ── WhatsApp Cloud API (Meta) ───────────────────────────────────
# All three empty = webhook routes return "not configured".
# Get these from developers.facebook.com → your app → WhatsApp.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ── Payments ────────────────────────────────────────────────────
# Incoming payments POST to /api/payments/incoming — from a payment
# gateway webhook, a staff entry, or a UPI ref the customer typed.
# The matching engine links each payment to its order, confirms the
# customer instantly, and only pings the owner on problems
# (wrong amount, no matching order, duplicate).
# Set a shared secret so you can authenticate gateway webhook calls.
PAYMENT_WEBHOOK_SECRET=

# ── Voice: async-first ──────────────────────────────────────────
# WhatsApp voice notes are transcribed and answered with no telephony
# cost. Any OpenAI-compatible /audio/transcriptions endpoint works:
# OpenAI Whisper, or Sarvam AI for Telugu/Hindi (see ROADMAP.md).
# Empty key = voice notes get an honest "please type it" reply.
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1

# ── Live telephony: PREMIUM roadmap module, NOT built ─────────────
# Hooks only (app/telephony.py). See ROADMAP.md for the ₹2-3/min
# cost target and the levers (Exotel/Plivo, Sarvam AI, small models).
TELEPHONY_ENABLED=false
# TELEPHONY_PROVIDER=exotel
# EXOTEL_SID= / EXOTEL_TOKEN= / EXOTEL_FROM=
# PLIVO_AUTH_ID= / PLIVO_AUTH_TOKEN= / PLIVO_FROM=

# ── Defaults ────────────────────────────────────────────────────
DEFAULT_LANGUAGE=en              # en | hi (Hindi) — more locales: add i18n/<code>.json
DEFAULT_SLOT_MINUTES=30
DEFAULT_CURRENCY=INR
